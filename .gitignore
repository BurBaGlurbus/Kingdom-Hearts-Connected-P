# Default deny: only maintained code, documentation and authored fixtures enter Git.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/SECURITY.md
!/AGENTS.md
!/LICENSE
!/NOTICE
!/CREDITS.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/.cargo/config.toml
!/.github/workflows/*.yml
!/build.bat
!/tools/*.ps1
!/assets/*.png
!/docs/**/*.md
!/docs/release/*-LICENSE.txt
!/docs/release/*-MIT.txt
!/docs/release/*-Zlib.txt
!/source/*/Cargo.toml
!/source/*/src/**/*.rs
!/source/kh3_data/src/recipes/*.tsv
!/source/khc/blocklist.txt
!/source/**/Cargo.toml
!/source/**/*.rs
!/source/**/*.wgsl
!/source/**/README.md
!/source/engine/assets/development-checker.bmp
/target/
.local/
